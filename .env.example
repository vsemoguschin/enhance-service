# enhance-service config (values are examples — set real secret in deploy env)

# Shared secret for X-Enhance-Api-Key (empty = auth disabled, dev only)
ENHANCE_API_KEY=

# Engine (realesrgan-ncnn-vulkan). Defaults resolve to ./bin and ./models.
# ENHANCE_NCNN_BIN=/opt/enhance-service/bin/realesrgan-ncnn-vulkan
# ENHANCE_MODEL_DIR=/opt/enhance-service/models
ENHANCE_MODEL_NAME=realesrgan-x4plus
# ncnn tile size, 0 = auto (lower = less RAM, slower)
ENHANCE_NCNN_TILE=0

# Work dir for temp in/out files
ENHANCE_WORK_DIR=/tmp/enhance

# Limits
ENHANCE_MAX_OUTPUT_PX=7200       # cap longest output side
ENHANCE_MAX_OUTPUT_MB=20         # cap result file size (file-platform limit)
ENHANCE_MAX_INPUT_MP=80          # cap input megapixels
ENHANCE_MAX_INPUT_MB=60          # cap input file size (>= book-editor EditorAsset 50MB)
ENHANCE_QUEUE_MAX=20             # bounded queue length (over -> 429)
# Сколько джобов считается одновременно. Дефолт: 1 для local (ncnn упирается в CPU),
# 4 для magnific (воркер ждёт сеть). Потолок для magnific задаёт rate limit API — см. ниже.
ENHANCE_WORKERS=
ENHANCE_JOB_TIMEOUT_S=660
ENHANCE_JPEG_QUALITY=95
ENHANCE_RESULT_TTL_S=3600        # delete result/job after this

# Провайдер движка: local (ncnn Real-ESRGAN, нужен GPU для приемлемой скорости)
# или magnific (внешний API — компьют уходит наружу, боксу GPU не нужен)
ENHANCE_PROVIDER=local

# ── Magnific API (внешний провайдер апскейла, https://api.magnific.com) ──────
# Ключ из кабинета: Settings -> API Keys. Значение держать только в .env (он в .gitignore).
MAGNIFIC_API_KEY=
# Webhook signing secret оттуда же: HMAC-SHA256 по "webhook-id.webhook-timestamp.body",
# подпись приходит в заголовке webhook-signature. Нужен только когда включён webhook_url;
# для локального smoke-теста (polling) не используется.
MAGNIFIC_WEBHOOK_SECRET=
MAGNIFIC_BASE_URL=https://api.magnific.com
# Меньше 180с, которые ждёт book-editor: сервис должен сдаваться раньше клиента,
# иначе кредиты уходят на результат, который уже некому забрать.
MAGNIFIC_TIMEOUT_S=150
# Опрос статуса расходует тот же лимит API (50 запросов/мин на ключ), что и постановка задач.
# При 4 воркерах и опросе раз в 8с выходит ~38 запросов/мин — запас к лимиту около 20%.
MAGNIFIC_POLL_S=8
# Промпт восстановления: texture (дефолт прода) | old-photo | restore | detail | web.
# Тексты — в app/prompts.py, подобраны на реальных фото.
MAGNIFIC_PRESET=texture
# Апскейл после восстановления. Тарифицируется по площади результата (~18 кредитов на Мп),
# поэтому по умолчанию выключен: генеративный шаг и так отдаёт ~4 Мп (18x15 см при 300 DPI).
MAGNIFIC_UPSCALE=false
# Мягкие автоуровни (CLAHE) перед отправкой — бесплатно и снимает провалы в тенях.
MAGNIFIC_AUTOCONTRAST=true

# Для ручных экспериментов через scripts/magnific_smoke.py:
# precision-v2 | precision | creative | seedream-edit | nano-banana
MAGNIFIC_ENGINE=seedream-edit
