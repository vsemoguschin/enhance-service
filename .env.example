# enhance-service config (values are examples — set real secret in deploy env)

# Shared secret for X-Enhance-Api-Key (empty = auth disabled, dev only)
ENHANCE_API_KEY=

# Engine (realesrgan-ncnn-vulkan). Defaults resolve to ./bin and ./models.
# ENHANCE_NCNN_BIN=/opt/enhance-service/bin/realesrgan-ncnn-vulkan
# ENHANCE_MODEL_DIR=/opt/enhance-service/models
ENHANCE_MODEL_NAME=realesrgan-x4plus
# ncnn tile size, 0 = auto (lower = less RAM, slower)
ENHANCE_NCNN_TILE=0

# Work dir for temp in/out files
ENHANCE_WORK_DIR=/tmp/enhance

# Limits
ENHANCE_MAX_OUTPUT_PX=7200       # cap longest output side
ENHANCE_MAX_OUTPUT_MB=20         # cap result file size (file-platform limit)
ENHANCE_MAX_INPUT_MP=80          # cap input megapixels
ENHANCE_MAX_INPUT_MB=60          # cap input file size (>= book-editor EditorAsset 50MB)
ENHANCE_QUEUE_MAX=20             # bounded queue length (over -> 429)
# Сколько джобов считается одновременно. Дефолт: 1 для local (ncnn упирается в CPU),
# 4 для magnific (воркер ждёт сеть). Потолок для magnific задаёт rate limit API — см. ниже.
ENHANCE_WORKERS=
ENHANCE_JOB_TIMEOUT_S=660
ENHANCE_JPEG_QUALITY=95
ENHANCE_RESULT_TTL_S=3600        # delete result/job after this

# Провайдер движка: local (ncnn Real-ESRGAN, нужен GPU для приемлемой скорости)
# или magnific (внешний API — компьют уходит наружу, боксу GPU не нужен)
ENHANCE_PROVIDER=local

# ── Magnific API (внешний провайдер апскейла, https://api.magnific.com) ──────
# Ключ из кабинета: Settings -> API Keys. Значение держать только в .env (он в .gitignore).
MAGNIFIC_API_KEY=
# Webhook signing secret оттуда же: HMAC-SHA256 по "webhook-id.webhook-timestamp.body",
# подпись приходит в заголовке webhook-signature. Нужен только когда включён webhook_url;
# для локального smoke-теста (polling) не используется.
MAGNIFIC_WEBHOOK_SECRET=
MAGNIFIC_BASE_URL=https://api.magnific.com
# Меньше 180с, которые ждёт book-editor: сервис должен сдаваться раньше клиента,
# иначе кредиты уходят на результат, который уже некому забрать.
MAGNIFIC_TIMEOUT_S=150
# Опрос статуса расходует тот же лимит API (50 запросов/мин на ключ), что и постановка задач.
# При 4 воркерах и опросе раз в 8с выходит ~38 запросов/мин — запас к лимиту около 20%.
MAGNIFIC_POLL_S=8
# Промпт восстановления: texture (дефолт прода) | old-photo | restore | detail | web.
# Тексты — в app/prompts.py, подобраны на реальных фото.
MAGNIFIC_PRESET=identity
# Апскейл после восстановления. Тарифицируется по площади результата (~18 кредитов на Мп),
# поэтому по умолчанию выключен: генеративный шаг и так отдаёт ~4 Мп (18x15 см при 300 DPI).
MAGNIFIC_UPSCALE=false
# Мягкие автоуровни (CLAHE) перед отправкой — бесплатно и снимает провалы в тенях.
MAGNIFIC_AUTOCONTRAST=true

# Для ручных экспериментов через scripts/magnific_smoke.py:
# precision-v2 | precision | creative | seedream-edit | nano-banana
MAGNIFIC_ENGINE=seedream-edit

# ── Провайдер codex (Codex CLI + встроенный imagegen) ───────────────────────
# Оплата подпиской, а не за вызов. Качество лучшее из проверенных, но медленнее
# (~2 мин на фото) и агент нестабилен: иногда отдаёт слабее, чем в интерактиве.
# Полный путь обязателен: PATH у pm2-процесса обычно не содержит npm-global.
CODEX_BIN=/opt/codex/.npm-global/bin/codex
# preserve (с 21.08) — не просит «восстановить» и «увеличить»: обе формулировки
# провоцировали пересборку кадра. Кадр остаётся тем же, чёткость добавляет FINISH_* ниже.
# identity — прежний прод-пресет, оставлен для сравнения.
CODEX_PRESET=preserve
# Три-пять входов в один imagegen: основной кадр + тени + фактура, а при уверенно
# найденных лицах — один непрерывный identity-crop и, для одного тёмного лица, его тени.
# false — быстрый откат на прежний single-reference маршрут.
CODEX_MULTI_REFERENCE=true
# Оригиналы до порога остаются без resize. Более крупные передаются рабочей копией 2048 px;
# исходник сохраняется и используется для максимально качественного identity-crop.
CODEX_ADAPTIVE_INPUT=true
CODEX_INPUT_DOWNSCALE_THRESHOLD_PX=2560
CODEX_INPUT_MAX_PX=2048
# Верхняя граница двух полноразмерных supporting references.
CODEX_REFERENCE_MAX_PX=4096
# Автоматический face-reference через YuNet. Детектор работает не крупнее 2560 px, но crop
# берётся из полного оригинала и только уменьшается до 1024. Нет модели/уверенной детекции —
# безопасный fallback на три общих references; Haar не используется из-за ложных лиц.
CODEX_FACE_REFERENCE=true
CODEX_FACE_MODEL=/opt/enhance-service/models/face_detection_yunet_2023mar.onnx
CODEX_FACE_DETECT_MAX_PX=2560
CODEX_FACE_REFERENCE_MAX_PX=1024
CODEX_FACE_SCORE_THRESHOLD=0.85
CODEX_FACE_MIN_PX=20
CODEX_FACE_RELATIVE_MIN_SCALE=0.5
CODEX_FACE_MAX_COUNT=16
# Средняя яркость L (0..255), ниже которой одиночному лицу добавляется пятый shadow-ref.
CODEX_FACE_SHADOW_MAX_LUMA=90
# Максимальный тест multi-reference — 165с чистой генерации; 240с оставляет время
# до клиентского дедлайна 300с на быстрый fallback.
CODEX_TIMEOUT_S=240

# Локальная детализация поверх результата модели (app/finish.py).
# Нужна потому, что под запретами модель возвращает кадр без прибавки резкости:
# замер 21.08 — 637 против 644 у оригинала. Считается за доли секунды и ничего не выдумывает.
FINISH_DETAIL=true
# Мягкий финиш, выбранный владельцем 27.08 на селфи и панораме.
FINISH_DETAIL_AMOUNT=0.25
FINISH_DETAIL_SIGMA_COLOR=24
FINISH_DETAIL_SIGMA_SPACE=6
# Обрабатывать только канал яркости, цвет не трогать. По каналам BGR та же сила
# сдвигала цветность и кадр читался как «выкрученный»; по яркости цветность
# не меняется вовсе (замер 21.08: 17.09 против 17.11 у входа).
FINISH_LUMA_ONLY=true
# Multi-reference уже проявляет тени, поэтому дополнительный CLAHE на выходе выключен.
FINISH_MICRO_CONTRAST=0.0
# Финальная резкость только там, где есть перепад ≥ порога — порог держит шум в тенях.
FINISH_SHARPEN_AMOUNT=0.20
FINISH_SHARPEN_RADIUS=1.1
FINISH_SHARPEN_THRESHOLD=4

# Запасной провайдер, если основной не справился (ошибка, таймаут) или задача
# слишком долго ждала в очереди. Пусто = выключено.
ENHANCE_FALLBACK=magnific
ENHANCE_FALLBACK_AFTER_WAIT_S=60
